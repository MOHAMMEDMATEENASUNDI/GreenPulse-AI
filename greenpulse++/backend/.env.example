# ==============================================================================
# GreenPulse AI Backend - Environment Configuration (.env.example)
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/greenpulse_ai

# Security & JWT
# Minimum 16 characters required
JWT_SECRET=your_super_secret_jwt_access_key_min_16_chars
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_key_min_16_chars

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK (Optional / Service Account)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"
